{
  "name": "agilebuilder",
  "version": "1.0.16",
  "description": "AI-native developer tooling for template-based project creation and document-guided development via CLI, Web UI, and MCP.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "bin": {
    "agilebuilder": "./bin/agilebuilder.js",
    "ag": "./bin/agilebuilder.js",
    "agilebuilder-mcp": "./bin/mcp.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/test",
    "bin",
    "ui/dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch src/cli/index.ts",
    "prebuild": "npm run clean && node scripts/generate-backend-profiles.mjs",
    "build": "tsc && npm run build:ui",
    "build:ui": "cd ui && npm run build",
    "start": "node dist/cli/index.js",
    "mcp": "node dist/mcp/index.js",
    "ui:dev": "cd ui && npm run dev",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs --unit-only",
    "test:smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "scaffold",
    "scaffolding",
    "template",
    "cli",
    "mcp",
    "model-context-protocol",
    "ai",
    "project-generator",
    "boilerplate",
    "starter",
    "vue",
    "react",
    "typescript",
    "git-template"
  ],
  "author": "wangjindong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agilebuilder/agilebuilder-core.git"
  },
  "bugs": {
    "url": "https://github.com/agilebuilder/agilebuilder-core/issues"
  },
  "homepage": "https://www.agilebuilder.net",
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "inquirer": "^13.3.0",
    "open": "^10.0.0",
    "ora": "^8.0.1",
    "simple-git": "^3.33.0",
    "sql.js": "^1.13.0",
    "undici": "^7.24.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^20.11.0",
    "@types/sql.js": "^1.4.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
